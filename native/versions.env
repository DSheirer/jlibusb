# Pinned native sources for jlibusb releases. Sourced by the build scripts and
# read by the GitHub workflows. To move to a new libusb release, change these
# values and open a pull request.
#
# LIBUSB_VERSION is also the jlibusb version. The Linux and macOS libraries are
# built from the release tarball; Windows uses the prebuilt DLLs that the
# libusb project publishes with each release.
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
